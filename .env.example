# Токен бота от @BotFather — единственная обязательная настройка.
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Ваш Telegram user id. Можно не заполнять: владельцем станет тот,
# кто первым напишет боту /start. Узнать id: @userinfobot
OWNER_ID=

# Канал с блогом: -1001234567890 или @myblog.
# Если оставить пустым, бот индексирует все каналы, куда его добавили админом.
BLOG_CHAT_ID=

# Часовой пояс, по которому определяется «этот день».
TIMEZONE=Europe/Moscow

# Когда присылать напоминание. Диапазон — случайный момент внутри него,
# одно значение (например 10:00) — строго это время.
DIGEST_WINDOW=12:00

# Насколько старой должна быть запись, чтобы стать воспоминанием.
MIN_YEARS_AGO=1

# Файл с архивом.
DB_PATH=data/memorybot.sqlite3

# Свой сервер Bot API вместо api.telegram.org. Нужен, только если хотите
# присылать боту экспорт больше 20 МБ прямо в чат.
TELEGRAM_API_BASE=
